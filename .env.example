# DeepSeek API (Anthropic-compatible endpoint)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI-compatible API (optional)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Runtime limits: canonical budget/deadline fields; 0 means unlimited
# FIXLOOP_BUDGET_MAX_LLM_CALLS=20
# FIXLOOP_BUDGET_MAX_TOOL_CALLS=40
# FIXLOOP_DEADLINE_REPAIR_S=600
# FIXLOOP_DEADLINE_STEP_S=120
# FIXLOOP_DEADLINE_TOOL_S=30

# HuggingFace semantic model (optional; auto-offline when cache exists)
# HF_HUB_OFFLINE=1
# HF_ENDPOINT=https://hf-mirror.com
